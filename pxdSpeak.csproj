<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 SDK target: the built-in Windows voices come from Windows.Media.SpeechSynthesis -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>pxdSpeak</RootNamespace>
    <AssemblyName>pxdSpeak</AssemblyName>
    <Version>1.0.0</Version>
    <Product>pxd Speak</Product>
    <Company>pxd</Company>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets\pxdSpeak.ico')">Assets\pxdSpeak.ico</ApplicationIcon>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <!-- Self-test only: draws the windows with no OS window at all -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <!-- Offline neural voices (Kokoro, Piper). 1.13.x still phonemizes English itself; 2.x dropped that. -->
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.8" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <!-- The voice packs are .tar.bz2 -->
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The browser extension ships next to the exe; the user loads it unpacked from there -->
    <None Include="BrowserExtension/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Chatterbox voice server, written out next to its private Python when installed -->
    <EmbeddedResource Include="Chatterbox/server.py" LogicalName="pxdSpeak.Chatterbox.server.py" />
    <EmbeddedResource Include="Chatterbox/requirements.txt" LogicalName="pxdSpeak.Chatterbox.requirements.txt" />
  </ItemGroup>

  <Target Name="TrimPublish" AfterTargets="Publish">
    <ItemGroup>
      <_PruneFiles Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PruneFiles)" />
  </Target>

</Project>
